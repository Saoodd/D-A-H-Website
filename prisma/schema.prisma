// Dar Al Hay (DAH) — data model
// SQLite for local dev / small deployments. Swap `provider`/`url` to point at
// Postgres (e.g. Vercel Postgres, Neon, Supabase) for a production deployment
// with concurrent serverless writes — see README "Database" section.
//
// NOTE: SQLite has no native enum support in Prisma, so status-like fields
// below are plain Strings. The allowed values are enforced in TypeScript —
// see lib/constants.ts for the canonical lists (kept in sync with the
// comments here).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection — Postgres advisory
  // locks, which `prisma migrate deploy` uses to prevent concurrent
  // migration races, don't work reliably over a PgBouncer-style pooler in
  // transaction mode: the lock can be granted and released on different
  // underlying connections, so Prisma's wait for the lock times out (P1002)
  // even though the pooled connection itself is reachable. DIRECT_URL must
  // be set everywhere DATABASE_URL is (Prisma does not fall back if it's
  // missing) — locally it's fine for both to point at the same database;
  // in production set DIRECT_URL to the provider's non-pooled connection
  // string — for Vercel Postgres/Neon that's the value normally exposed as
  // POSTGRES_URL_NON_POOLING.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Site-wide settings (singleton row, id = "singleton")
// ---------------------------------------------------------------------------
model Settings {
  id                             String  @id @default("singleton")
  mainCommunityWhatsappLink      String? // Main DAH Community Group — account-level, not tied to any event
  defaultAcceptanceDeadlineHours Int     @default(3)

  // Single source of truth for contact details shown across the public site
  // (Contact page, footer, emails) — never hardcode these in components.
  contactEmail           String?
  contactInstagramHandle String? // without the leading @

  // Single source of truth for the trade-license requirement so vendor
  // registration copy and the Terms & Conditions page can never contradict
  // each other. false = optional (default — matches current stated policy).
  tradeLicenseRequired Boolean @default(false)

  // Global default for whether a vendor may hold/book more than one booth
  // (max 2, see MAX_BOOTHS_PER_BOOKING in lib/constants.ts — not itself
  // configurable yet) in a single application. Event.allowMultipleBooths
  // overrides this per event, same nullable-override pattern as
  // acceptanceDeadlineHours above. false = single-booth only (default —
  // matches current behavior for every existing event).
  allowMultipleBoothsDefault Boolean @default(false)

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Pricing — global, editable from the admin panel. Booths reference a tier by
// `sizeKey`. Changing a tier's price only affects new/unsold bookings; a sold
// booth keeps `priceAedFilsAtSale` as a historical record.
// ---------------------------------------------------------------------------
model PricingTier {
  id           String   @id @default(cuid())
  sizeKey      String   @unique // e.g. "2x2", "3x2" — matches Booth.size
  label        String // e.g. "2m x 2m kiosk"
  priceAedFils Int // stored in fils (1 AED = 100 fils) to avoid float errors
  vatInclusive Boolean  @default(true)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @default("")
  startDate   DateTime
  endDate     DateTime?
  location    String
  coverImage  String?
  categories  String[]  @default([]) // vendor categories relevant to this event — shown publicly and offered as choices on the application form
  status      String    @default("DRAFT") // DRAFT | PUBLISHED | CLOSED

  // Whether the public event page shows a "Booths from AED X" starting
  // price. Defaults on to match prior behavior; admin can hide it per event.
  showPublicPricing Boolean @default(true)

  // Optional background image for the floor plan builder/viewer — when set,
  // booth/feature gridX/Y/W/H are read as percentages (0-100) of this
  // image's width/height, so admin can click directly on a real venue photo
  // or architectural drawing to place booths instead of guessing coordinates.
  floorPlanImageUrl String?
  // Real width, in meters, that the floor plan canvas represents — optional.
  // When set, the floor plan builder's drag distance/spacing guides show
  // real meters (derived from this scale) instead of a raw canvas percentage.
  venueWidthM       Float?

  whatsappVendorGroupLink String? // event-specific, payment-gated

  // Overrides Settings.defaultAcceptanceDeadlineHours for this event only.
  acceptanceDeadlineHours Int?

  // Overrides Settings.allowMultipleBoothsDefault for this event only —
  // lets DAH turn 2-booth bookings on/off per event without a code change.
  allowMultipleBooths Boolean?

  booths           Booth[]
  features         FloorPlanFeature[]
  applications     Application[]
  pricingOverrides EventPricing[]
  vendorWarnings   VendorWarning[]
  agreements       Agreement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-event override of a PricingTier's price — lets DAH charge a
// different booth fee at a specific market without changing the global
// default. Falls back to PricingTier.priceAedFils when no row exists here.
model EventPricing {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sizeKey      String // matches PricingTier.sizeKey
  priceAedFils Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([eventId, sizeKey])
}

model FloorPlanFeature {
  id       String @id @default(cuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // ENTRANCE_MAIN | ENTRANCE_SIDE | TOILET_FEMALE | TOILET_MALE | OFFICE | LOADING | STAIRS | OTHER
  type     String
  label    String
  // Position/size as a percentage (0-100) of the floor plan canvas/image.
  // See components/floorplan.
  gridX    Float
  gridY    Float
  gridW    Float
  gridH    Float
  rotation Int    @default(0) // degrees, for arrow/door orientation

  createdAt DateTime @default(now())
}

model Booth {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  code String // unique WITHIN the event, e.g. "A5", "B29"
  size String @default("custom") // references PricingTier.sizeKey when set; "custom" when price/color are set directly per booth

  // Per-booth overrides — set directly when adding a booth (name/price/color
  // flow). When priceAedFils is null, price falls back to the event-level
  // then global PricingTier lookup by `size`. When colorHex is null, the
  // floor plan renders the size-tier palette color instead.
  priceAedFils Int?
  colorHex     String?

  // The booth's real physical footprint, in millimeters — set by Admin
  // (see requirement: admin floor-plan/booth editor). Deliberately separate
  // from `gridW`/`gridH` below, which are canvas-percentage POSITION/size
  // for rendering only and do not reliably correspond to real-world
  // dimensions (e.g. a newly placed booth defaults to a fixed 6% canvas
  // box regardless of its actual size). Null on any booth Admin hasn't
  // configured yet — the size-fit check (lib/boothFit.ts) simply skips
  // itself when either side of the comparison is unknown, never blocking
  // a booking over data DAH hasn't entered.
  widthMm Int?
  depthMm Int?

  // Position/size as a percentage (0-100) of the floor plan canvas/image —
  // lets the admin click-to-place a booth instead of typing coordinates.
  gridX    Float
  gridY    Float
  gridW    Float
  gridH    Float
  rotation Int   @default(0) // degrees, set by dragging the rotate handle in the floor plan builder

  status String @default("AVAILABLE") // AVAILABLE | HELD | RESERVED | SOLD

  // System-driven hold (5 min review / 5 min payment) — enforced server-side
  // by checking holdExpiresAt on every read/write, never trusting the client.
  holdStage           String? // REVIEW | PAYMENT
  holdExpiresAt       DateTime?
  heldByApplicationId String?
  heldByApplication   Application? @relation("BoothHeldBy", fields: [heldByApplicationId], references: [id])

  // Admin-driven manual reservation/sale — no timer.
  assignedApplicationId String?
  assignedApplication   Application? @relation("BoothAssignedTo", fields: [assignedApplicationId], references: [id])
  manualAssigneeName    String? // for walk-ins/favors with no application on file

  priceAedFilsAtSale Int? // snapshot of price actually charged/reserved at, historical
  soldAt             DateTime?

  payments      Payment[]
  paymentBooths PaymentBooth[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, code])
}

// A Vendor is a DAH business account — created once at signup, independent
// of any event. `verified` gates the vendor dashboard: an unverified vendor
// can log in but sees nothing until DAH manually verifies their business
// (Admin → Vendors). Once verified, they can apply to individual published
// events from their dashboard (see Application below).
model Vendor {
  id            String  @id @default(cuid())
  email         String  @unique
  // The vendor's chosen sign-in name, in the exact casing they typed —
  // shown back to them everywhere. `usernameLower` is the real uniqueness
  // and lookup key (trimmed + lowercased): "SaeedStore", "saeedstore" and
  // " SaeedStore " are all the same account, enforced by the unique index
  // below, not just app-level checks, so a race between two signups can
  // never both succeed.
  username      String
  usernameLower String  @unique
  passwordHash  String
  businessName  String
  contactName   String
  phone         String
  category      String // one of lib/constants.ts VENDOR_CATEGORIES, or free text under "Other"
  description   String  @default("") // short business description, shown to admin during verification
  instagram     String?
  verified      Boolean @default(false)

  // Business profile — vendor-editable via /vendor/profile. All optional:
  // trade license fields stay optional even when Settings.tradeLicenseRequired
  // is on (that setting gates applying to events, not account creation).
  logoUrl             String?
  website             String?
  tradeLicenseNumber  String?
  tradeLicenseFileUrl String? // uploaded via the existing Vercel Blob setup, same as floor plan images
  tradeLicenseExpiry  DateTime?

  // `emailVerifiedAt` is a REAL verification flag — set only when the vendor
  // actually clicks and successfully confirms the link sent to their email
  // (see EmailVerificationToken below), never automatically at signup. It is
  // never checked as a gate anywhere (see lib/verification.ts): email is a
  // normal account-communication channel (login, password reset, receipts),
  // shown on Profile/Admin for informational purposes only.
  //
  // Phone verification is the one real eligibility gate — see
  // lib/verification.ts requirePhoneVerifiedVendor(). `phoneVerifiedNumber`
  // is the exact E.164 number that was actually verified: if it no longer
  // matches the current normalized `phone`, the phone is treated as
  // unverified again automatically (see PHONE CHANGE requirement) without
  // needing every phone-editing code path to remember to clear a flag.
  // `phoneVerifiedMethod` records how the CURRENT verification happened
  // ("SMS" via Infobip 2FA, or "ADMIN" via manual admin override) — full
  // history of every verification event (including ones since superseded by
  // a phone change) lives in VendorPhoneVerificationLog below.
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  phoneVerifiedNumber String?
  phoneVerifiedMethod String?

  // Transient state for the CURRENT in-flight Infobip OTP attempt only —
  // unrelated to the settled phoneVerified* fields above. Set together each
  // time a code is sent (send or resend both overwrite these, invalidating
  // any prior attempt); cleared on successful verification. `phoneOtpPhone`
  // guards against verifying a stale pinId against a number the vendor has
  // since changed (see PHONE CHANGE requirement) — see
  // app/api/vendor/phone-verification/confirm/route.ts.
  phoneOtpPinId String?
  phoneOtpPhone String?

  // WhatsApp broadcast consent — separate from phone verification, and
  // separate from any WhatsApp community-group link (Settings/Event
  // fields above, which are just admin-pasted chat.whatsapp.com URLs, not
  // a messaging channel). Gates the Admin Communications Center's
  // WhatsApp channel: a vendor is only proactively messaged once opted
  // in. Every vendor, including every pre-existing row, starts unset —
  // nobody is retroactively opted in by adding this field.
  whatsappOptInAt     DateTime?
  whatsappOptInMethod String? // VENDOR | ADMIN — ADMIN covers consent obtained outside the app and recorded manually
  whatsappOptOutAt    DateTime?

  applications             Application[]
  notes                    VendorNote[]
  warnings                 VendorWarning[]
  emailVerificationTokens  EmailVerificationToken[]
  phoneVerificationLogs    VendorPhoneVerificationLog[]
  emailDeliveries          EmailDelivery[]
  whatsappDeliveries       WhatsAppDelivery[]
  communicationRecipients  CommunicationRecipient[]
  // Every Agreement (VENDOR_TERMS at signup, EVENT_TERMS per booking) this
  // vendor has accepted — look up the VENDOR_TERMS one via
  // `agreementAcceptances.find(a => a.agreement.type === "VENDOR_TERMS")`
  // rather than a direct pointer, since the acceptance row can only be
  // created after this Vendor row exists.
  agreementAcceptances    AgreementAcceptance[]
  passwordResetTokens     PasswordResetToken[]
  emailChangeTokens       EmailChangeToken[]
  sessions                VendorSession[]

  // Soft-delete: closing an account never deletes the row (agreements,
  // payments and bookings all reference vendorId and must stay readable),
  // it just disables login and clears non-required personal data. Keeping
  // the row also keeps `usernameLower`/`email` reserved in their unique
  // indexes, so a closed account's identifiers can never be immediately
  // claimed by someone else.
  //
  // DELETED is a stronger, admin-only state on top of the same mechanism
  // (see lib/vendorDeletion.ts): the Vendor row is still never hard-deleted
  // — AgreementAcceptance.vendorId cascades directly from this row, so a
  // real `prisma.vendor.delete()` would destroy signed agreements — instead
  // the row is anonymized in place and kept as a tombstone, which is also
  // what keeps `usernameLower` permanently reserved (requirement: a
  // permanently removed vendor's username must never be immediately
  // reusable). Every existing gate in the codebase already checks
  // `accountStatus !== "ACTIVE"` rather than `=== "CLOSED"`, so DELETED is
  // blocked everywhere CLOSED already was, with no other code changes.
  accountStatus        String    @default("ACTIVE") // ACTIVE | CLOSED | DELETED
  closedAt             DateTime?
  permanentlyDeletedAt DateTime? // set once, by an admin, via lib/vendorDeletion.ts — never by the vendor themselves
  emailChangedAt       DateTime? // last time the login email was changed, for audit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per issued vendor login session — makes the session cookie
// actually revocable, unlike a bare stateless JWT. The JWT carries this
// row's id (`sid`); every request re-checks the row here, so logout (this
// row only) and a password reset (every row for this vendor) both take
// effect immediately, not just whenever the token happens to expire on its
// own. `revokedAt` rather than deleting the row keeps a short audit trail.
model VendorSession {
  id        String    @id @default(cuid())
  vendorId  String
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([vendorId])
}

// Same revocable-session pattern for Admin. Admin has no per-user DB row
// (a single shared password, see .env ADMIN_PASSWORD) so there's no vendorId
// equivalent to scope by — logging out revokes just this session's row,
// keeping other concurrently-open admin sessions valid.
model AdminSession {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
}

// Single-use, expiring "forgot password" token. Only a hash is stored —
// the raw token exists solely in the emailed link — so a leaked database
// snapshot can never be used to reset a vendor's password. Every request
// (even for an unknown email) responds identically; this table only fills
// in when the email genuinely matches an account.
model PasswordResetToken {
  id        String    @id @default(cuid())
  vendorId  String
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([vendorId])
}

// Verifies a NEW email address before it becomes the account's real login
// email — the login identifier only changes once this token is consumed,
// so a mistyped or unreachable new address can never lock a vendor out.
model EmailChangeToken {
  id        String    @id @default(cuid())
  vendorId  String
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([vendorId])
}

// Internal delivery log for every transactional email DAH sends — lets
// Admin see sent/delivered/failed status and retry a genuinely failed send,
// without ever storing the email body, tokens, or credentials here.
// `dedupeKey`, when set, is a stable key for the underlying business event
// (e.g. "application_accepted:<applicationId>:<acceptedAt>") — writing a
// second row with the same key hits the unique constraint and is treated as
// "already sent", so a retried request can never fire the same
// notification twice. Rows without a natural one-shot business event (e.g.
// a resendable verification email) simply leave this null.
model EmailDelivery {
  id                String    @id @default(cuid())
  type              String // e.g. EMAIL_VERIFY, PASSWORD_RESET, APPLICATION_ACCEPTED, PAYMENT_RECEIPT, WARNING, ...
  vendorId          String?
  vendor            Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  eventId           String? // Event.id, unrelated (log-only, no FK) so a later event deletion never touches this history
  toEmail           String
  provider          String    @default("resend")
  providerMessageId String?
  status            String    @default("QUEUED") // QUEUED | SENT | DELIVERED | BOUNCED | FAILED
  failReason        String?
  dedupeKey         String?   @unique
  queuedAt          DateTime  @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?

  @@index([vendorId])
  @@index([type])
  @@index([providerMessageId])
}

// Record of a sensitive, irreversible admin action — currently only the
// permanent vendor removal (see lib/vendorDeletion.ts). `vendorId` is
// deliberately a bare string, not a relation: the row it refers to may
// since have been anonymized (never hard-deleted, see Vendor.accountStatus
// DELETED above), and the log must survive regardless. `vendorRef` is a
// safe, human-readable snapshot (the vendor's usernameLower/businessName at
// the time of deletion) so Admin can still identify which account this was
// without looking up anything sensitive. Never stores passwords, tokens, or
// any personal data beyond that one reference.
model AdminAuditLog {
  id        String @id @default(cuid())
  action    String // e.g. VENDOR_PERMANENT_DELETE
  vendorId  String
  vendorRef String // usernameLower/businessName snapshot at the time of the action

  hadSelfClosed      Boolean // whether the vendor had already closed their own account before this
  applicationsKept   Int // applications anonymized-and-kept (had payment/agreement/booth history)
  applicationsPurged Int // applications hard-deleted (no history at all)
  blobsDeleted       Int // logo/trade-licence files removed from storage

  result    String // short human-readable outcome summary
  createdAt DateTime @default(now())

  @@index([vendorId])
}

// Single-use, expiring token proving the vendor controls the email address
// currently on file — used at signup (and any time the current address
// needs re-confirming). Distinct from EmailChangeToken, which verifies a
// NEW address before the login email switches to it. Only a hash is
// stored, same pattern as PasswordResetToken/EmailChangeToken.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  vendorId  String
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([vendorId])
}

// Append-only history of every phone-verification event for a vendor — an
// audit trail distinct from Vendor.phoneVerifiedAt/phoneVerifiedNumber/
// phoneVerifiedMethod (the CURRENT state only). Written on both a real
// Twilio Verify success (method "SMS") and an admin manual override
// (method "ADMIN") — Admin has no per-admin-user identity in this system
// (a single shared password, see AdminSession), so "who" can only ever be
// recorded generically as "ADMIN", not a named person.
model VendorPhoneVerificationLog {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  phone    String // the E.164 number verified at this moment
  method   String // SMS | ADMIN

  createdAt DateTime @default(now())

  @@index([vendorId])
}

// Private DAH-internal notes about a vendor — never returned by any
// vendor-facing API. Timestamped history rather than one editable text
// field, so nothing is ever silently overwritten.
model VendorNote {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  note     String

  createdAt DateTime @default(now())

  @@index([vendorId])
}

// An official notice/warning DAH issues to a vendor's business — distinct
// from VendorNote (private/internal): the vendor CAN see their own
// warnings (minus adminNote), can acknowledge having seen one, and admin
// can track view/ack/resolution over time. Warnings are a communication
// and history tool only — they never auto-reject or auto-ban a vendor
// unless that logic is explicitly added later.
model VendorWarning {
  id       String  @id @default(cuid())
  vendorId String
  vendor   Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  eventId  String?
  event    Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  title       String
  description String
  severity    String @default("NOTICE") // NOTICE | WARNING | FINAL_WARNING
  status      String @default("ACTIVE") // ACTIVE | RESOLVED | WITHDRAWN

  adminNote String? // private — never returned by vendor-facing APIs

  viewedAt       DateTime?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([eventId])
}

// A verified vendor's one-click application to a specific event, applied
// from their dashboard (no form — business info is already on file).
model Application {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Snapshot of the vendor's profile at the time they applied (vendor
  // profile may change later; keep what was true for this application).
  businessName String
  contactName  String
  phone        String
  email        String
  category     String
  instagram    String?

  // The vendor's declared stand/kiosk footprint FOR THIS EVENT, in
  // millimeters — collected once, at apply time (before booth selection),
  // and never silently changed afterward by an unrelated profile edit: a
  // vendor may bring a different physical setup to different events, so
  // this deliberately lives per-Application rather than on Vendor. Null
  // until the vendor actually enters it (existing/historical applications
  // predate this field). Editable via "Edit Setup Size" during booth
  // selection — see app/api/applications/[id]/setup-size/route.ts — which
  // only ever touches this same field, never Vendor's own profile.
  setupWidthMm Int?
  setupDepthMm Int?

  status String @default("PENDING") // PENDING | REJECTED | ACCEPTED | ACCEPTANCE_EXPIRED

  acceptedAt          DateTime?
  acceptanceExpiresAt DateTime? // deadline to complete payment; independent of booth holds
  acceptanceHoursUsed Int? // the hours value actually applied, for display/audit
  expiredAt           DateTime?
  rejectedAt          DateTime?

  cancellationRequests CancellationRequest[]
  adjustments          Adjustment[]
  payments             Payment[]
  agreementAcceptances AgreementAcceptance[]

  heldBooths     Booth[] @relation("BoothHeldBy")
  assignedBooths Booth[] @relation("BoothAssignedTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, status])
  @@index([vendorId])
}

model Payment {
  id            String         @id @default(cuid())
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  eventId       String
  // The PRIMARY/first booth this payment covers — kept as a direct scalar
  // FK (rather than removed in favor of `booths` below) so every existing
  // single-booth Payment row keeps working completely unchanged, and so
  // simple single-booth call sites never need to touch the join table.
  // `amountAedFils` is always the COMBINED total across every booth in
  // `booths` (one booth for a normal booking, up to two for a multi-booth
  // one) — see `booths` for the authoritative per-booth breakdown used by
  // receipts and multi-booth pricing.
  boothId       String
  booth         Booth          @relation(fields: [boothId], references: [id])
  // Every booth this one payment/booking actually covers, one row per
  // booth (including a mirror row for `boothId` itself) — the source of
  // truth for multi-booth receipts/pricing. A single-booth payment has
  // exactly one row here, identical to `boothId`/`amountAedFils`.
  booths        PaymentBooth[]

  amountAedFils Int
  currency      String @default("AED")
  status        String @default("PENDING") // PENDING | SUCCEEDED | FAILED

  provider    String // e.g. "sandbox", "ziina", "shopify_payments", "adcb"
  providerRef String? // charge/session id from the gateway

  // Assigned exactly once, atomically, the moment a payment actually
  // succeeds (via the ReceiptNumberSeq Postgres sequence — see migration) —
  // never a random client-side value, never reused, stable for the life of
  // the payment. Null for PENDING/FAILED payments, which have no receipt.
  receiptNumber String? @unique

  createdAt DateTime  @default(now())
  paidAt    DateTime?
}

// One row per (payment, booth) pair — lets a single Payment/receipt cover
// up to MAX_BOOTHS_PER_BOOKING (2) booths for a multi-booth booking, while
// every historical single-booth Payment still has exactly one row here
// (backfilled from its own boothId/amountAedFils in the migration that
// introduced this table) so nothing needs special-casing by booth count.
model PaymentBooth {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  boothId   String
  booth     Booth   @relation(fields: [boothId], references: [id])

  // Snapshot of that one booth's own price at the moment this payment was
  // charged — sums to Payment.amountAedFils across all rows for the same
  // payment. Kept per-row (not recomputed later) for the same historical-
  // accuracy reason Booth.priceAedFilsAtSale is a snapshot.
  priceAedFilsAtCharge Int

  @@unique([paymentId, boothId])
  @@index([boothId])
}

model Adjustment {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  amountAedFils  Int // can be negative for a discount/credit
  reason         String
  createdByAdmin Boolean     @default(true)
  createdAt      DateTime    @default(now())
}

model CancellationRequest {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reason        String
  status        String      @default("PENDING") // PENDING | ACKNOWLEDGED
  createdAt     DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Agreements — two independent, versioned document types, deliberately
// never mixed:
//   VENDOR_TERMS: one lineage per account signup (eventId always null).
//   EVENT_TERMS:  one independent lineage PER event (eventId always set) —
//                 duplicating an event copies the current text into a
//                 brand-new lineage, never linked back to the source
//                 event's, so editing one never touches the other.
// Only one row per (type, eventId) may be PUBLISHED at a time; editing a
// published agreement creates a new DRAFT version rather than overwriting
// it in place, so every past acceptance stays pinned to the exact text it
// was made against (see AgreementAcceptance.snapshotBodyHtml below).
// ---------------------------------------------------------------------------
model Agreement {
  id      String  @id @default(cuid())
  type    String // VENDOR_TERMS | EVENT_TERMS
  eventId String? // set only for EVENT_TERMS
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  version  Int
  title    String
  bodyHtml String @db.Text

  status      String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acceptances AgreementAcceptance[]

  @@unique([type, eventId, version])
  @@index([type, eventId, status])
}

// Immutable evidence of one vendor accepting one specific Agreement
// version. Snapshot fields are captured at accept-time and never change
// even if the Agreement row is later edited/republished as a new version
// — the signed record must always be readable exactly as it was accepted,
// independent of the live Agreement row.
model AgreementAcceptance {
  id          String    @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id])
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Set only for EVENT_TERMS acceptances — ties this acceptance to the
  // specific application/booking it was made for.
  applicationId      String?
  application        Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  representativeName String? // typed full name — EVENT_TERMS only

  snapshotType         String
  snapshotTitle        String
  snapshotVersion      Int
  snapshotBodyHtml     String  @db.Text
  snapshotBusinessName String
  snapshotContactName  String
  snapshotEventName    String? // EVENT_TERMS only

  ipAddress String?
  userAgent String?

  acceptedAt DateTime @default(now())

  @@index([vendorId])
  @@index([agreementId])
  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Admin Communications Center — manual/broadcast messaging to vendors,
// ADDITIVE to (never a replacement for) the automatic transactional
// notifications in lib/email/messages.ts, which continue to fire
// independently from their own existing call sites and are never touched
// by this. A Communication is one broadcast/campaign; each
// CommunicationRecipient is one (recipient, channel) delivery attempt
// within it. Email delivery status is tracked by reusing the existing
// EmailDelivery table (via dedupeKey `broadcast:<communicationId>:
// <vendorId>`, the same idempotency mechanism every automatic email
// already uses) rather than a parallel one; WhatsApp has no equivalent
// pre-existing table, so WhatsAppDelivery below mirrors EmailDelivery's
// shape/statuses/dedupeKey pattern exactly instead of inventing a
// different one.
// ---------------------------------------------------------------------------
model Communication {
  id             String @id @default(cuid())
  idempotencyKey String @unique // client-generated once, at the "Send" click — a double-click/page-refresh/serverless retry can never start a second real send for the same campaign

  internalName String // admin-facing label only, e.g. "Vol 5 Setup Instructions" — never shown to vendors
  sentByName   String? // free-text, admin-self-reported "sent by" — see AdminSession: this system has no per-admin login identity (one shared password), so this is the closest available attribution, not an authenticated actor

  channel String // EMAIL | WHATSAPP | BOTH

  eventId    String? // denormalized, no FK (like Payment.eventId) — null means "All Events" audience; a later event deletion must never break this history
  eventNames String? // snapshot label, e.g. "DAH Vol 5" or "All Events (3)" — for history display even if the Event is later renamed

  // The exact filter selection the admin made, as JSON — see
  // lib/communications/audience.ts AudienceFilters. Re-run through
  // resolveAudience() any time a DRAFT's live count needs recomputing.
  // This is NOT the recipient list — see CommunicationRecipient for the
  // frozen snapshot taken at send time.
  audienceFiltersJson String @db.Text
  audienceSummary     String // human-readable one-line summary, e.g. "DAH Vol 5 • Confirmed & Paid • Tier A"

  emailSubject  String?
  emailBodyHtml String? @db.Text // sanitized admin-authored HTML with {{variable}} placeholders still in place — substitution happens per recipient at send time

  whatsappTemplateName     String?
  whatsappTemplateLanguage String?
  whatsappVariablesJson    String? @db.Text // admin's {{1}}.. mapping to a dynamic field key or a literal string — see lib/communications/render.ts
  whatsappFreeformBody     String? @db.Text // only used for the explicit "free-form to the eligible subset" action

  status String @default("DRAFT") // DRAFT | SENDING | COMPLETED | PARTIALLY_FAILED | FAILED

  isTest Boolean @default(false) // true for a "Send Test" run — excluded from all vendor-facing history/stats

  totalRecipients Int @default(0)

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  recipients CommunicationRecipient[]

  @@index([eventId])
  @@index([status])
  @@index([createdAt])
}

// One row per (Communication, vendor, channel) — the frozen recipient
// snapshot AND the per-channel delivery pointer. Business/contact/booth/
// status fields are captured at send time and never change even if the
// vendor's real data changes later (a vendor paying 10 minutes after a
// send must not retroactively change who a completed campaign reached).
// The @@unique below is the row-level idempotency guard: a retried send
// for the same recipient+channel can never create a second row — see
// lib/communications/service.ts.
model CommunicationRecipient {
  id              String        @id @default(cuid())
  communicationId String
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  applicationId   String? // the specific booking this send was about, when the audience was event-scoped

  businessNameSnapshot      String
  contactNameSnapshot       String
  emailSnapshot             String?
  phoneSnapshot             String?
  boothCodesSnapshot        String? // comma-joined, e.g. "B14,B15"
  applicationStatusSnapshot String? // the DisplayStatus at send time, e.g. "PAID"

  channel     String // EMAIL | WHATSAPP
  destination String? // the email address or E.164 phone actually targeted

  emailDeliveryId    String? @unique // points into the existing EmailDelivery table (status kept current by the real Resend webhook)
  whatsappDeliveryId String? @unique // points into WhatsAppDelivery below

  status      String    @default("QUEUED") // QUEUED | SENT | DELIVERED | FAILED | SKIPPED
  skipReason  String? // e.g. "No email on file", "No WhatsApp opt-in", "Invalid phone", "Outside free-form window — template required"
  queuedAt    DateTime  @default(now())
  processedAt DateTime?

  @@unique([communicationId, vendorId, channel])
  @@index([communicationId])
  @@index([vendorId])
  @@index([status])
}

// WhatsApp's equivalent of EmailDelivery — same shape/statuses/dedupeKey
// idempotency pattern, deliberately mirrored rather than invented fresh.
// Written by lib/whatsapp/infobip.ts sendWhatsAppTemplate(); updated by
// the Infobip delivery-report webhook the same way
// app/api/webhooks/resend/route.ts updates EmailDelivery.
model WhatsAppDelivery {
  id                String    @id @default(cuid())
  type              String // e.g. BROADCAST — a future automatic WhatsApp notification could reuse this same table/type set
  vendorId          String?
  vendor            Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  eventId           String?
  toPhone           String // E.164
  provider          String    @default("infobip")
  templateName      String?
  providerMessageId String?
  status            String    @default("QUEUED") // QUEUED | SENT | DELIVERED | FAILED
  failReason        String?
  dedupeKey         String?   @unique
  queuedAt          DateTime  @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?

  @@index([vendorId])
  @@index([type])
  @@index([providerMessageId])
}

// Local cache of Infobip's real approved WhatsApp templates, refreshed by
// calling Infobip's live template-list API (lib/whatsapp/infobip.ts
// listWhatsAppTemplates()) — never a hand-typed hardcoded list. A row
// with source="MANUAL" is an admin-registered fallback for when the live
// call fails or returns a shape this app's parser doesn't recognize; the
// UI must never present a MANUAL row as "Approved" the way a SYNCED one
// is, since its approval status was never actually confirmed by Infobip.
model WhatsAppTemplateCache {
  id             String   @id @default(cuid())
  name           String
  language       String
  category       String? // e.g. MARKETING, UTILITY, AUTHENTICATION
  status         String? // whatever Infobip's API reports, e.g. APPROVED | PENDING | REJECTED
  bodyText       String?  @db.Text // template body with {{1}} {{2}} placeholders, for the admin preview
  variableCount  Int      @default(0)
  source         String   @default("SYNCED") // SYNCED | MANUAL
  isAuthTemplate Boolean  @default(false) // AUTHENTICATION-category templates are excluded from the broadcast picker entirely — OTP must never appear as a general broadcast template
  syncedAt       DateTime @default(now())

  @@unique([name, language])
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
