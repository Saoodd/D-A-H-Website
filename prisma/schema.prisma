// Dar Al Hay (DAH) — data model
// SQLite for local dev / small deployments. Swap `provider`/`url` to point at
// Postgres (e.g. Vercel Postgres, Neon, Supabase) for a production deployment
// with concurrent serverless writes — see README "Database" section.
//
// NOTE: SQLite has no native enum support in Prisma, so status-like fields
// below are plain Strings. The allowed values are enforced in TypeScript —
// see lib/constants.ts for the canonical lists (kept in sync with the
// comments here).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection — Postgres advisory
  // locks, which `prisma migrate deploy` uses to prevent concurrent
  // migration races, don't work reliably over a PgBouncer-style pooler in
  // transaction mode: the lock can be granted and released on different
  // underlying connections, so Prisma's wait for the lock times out (P1002)
  // even though the pooled connection itself is reachable. DIRECT_URL must
  // be set everywhere DATABASE_URL is (Prisma does not fall back if it's
  // missing) — locally it's fine for both to point at the same database;
  // in production set DIRECT_URL to the provider's non-pooled connection
  // string — for Vercel Postgres/Neon that's the value normally exposed as
  // POSTGRES_URL_NON_POOLING.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Site-wide settings (singleton row, id = "singleton")
// ---------------------------------------------------------------------------
model Settings {
  id                             String  @id @default("singleton")
  mainCommunityWhatsappLink      String? // Main DAH Community Group — account-level, not tied to any event
  defaultAcceptanceDeadlineHours Int     @default(3)

  // Single source of truth for contact details shown across the public site
  // (Contact page, footer, emails) — never hardcode these in components.
  contactEmail           String?
  contactInstagramHandle String? // without the leading @

  // Single source of truth for the trade-license requirement so vendor
  // registration copy and the Terms & Conditions page can never contradict
  // each other. false = optional (default — matches current stated policy).
  tradeLicenseRequired Boolean @default(false)

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Pricing — global, editable from the admin panel. Booths reference a tier by
// `sizeKey`. Changing a tier's price only affects new/unsold bookings; a sold
// booth keeps `priceAedFilsAtSale` as a historical record.
// ---------------------------------------------------------------------------
model PricingTier {
  id           String   @id @default(cuid())
  sizeKey      String   @unique // e.g. "2x2", "3x2" — matches Booth.size
  label        String // e.g. "2m x 2m kiosk"
  priceAedFils Int // stored in fils (1 AED = 100 fils) to avoid float errors
  vatInclusive Boolean  @default(true)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @default("")
  startDate   DateTime
  endDate     DateTime?
  location    String
  coverImage  String?
  categories  String[]  @default([]) // vendor categories relevant to this event — shown publicly and offered as choices on the application form
  status      String    @default("DRAFT") // DRAFT | PUBLISHED | CLOSED

  // Whether the public event page shows a "Booths from AED X" starting
  // price. Defaults on to match prior behavior; admin can hide it per event.
  showPublicPricing Boolean @default(true)

  // Optional background image for the floor plan builder/viewer — when set,
  // booth/feature gridX/Y/W/H are read as percentages (0-100) of this
  // image's width/height, so admin can click directly on a real venue photo
  // or architectural drawing to place booths instead of guessing coordinates.
  floorPlanImageUrl String?
  // Real width, in meters, that the floor plan canvas represents — optional.
  // When set, the floor plan builder's drag distance/spacing guides show
  // real meters (derived from this scale) instead of a raw canvas percentage.
  venueWidthM       Float?

  whatsappVendorGroupLink String? // event-specific, payment-gated

  // Overrides Settings.defaultAcceptanceDeadlineHours for this event only.
  acceptanceDeadlineHours Int?

  booths           Booth[]
  features         FloorPlanFeature[]
  applications     Application[]
  pricingOverrides EventPricing[]
  vendorWarnings   VendorWarning[]
  agreements       Agreement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-event override of a PricingTier's price — lets DAH charge a
// different booth fee at a specific market without changing the global
// default. Falls back to PricingTier.priceAedFils when no row exists here.
model EventPricing {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sizeKey      String // matches PricingTier.sizeKey
  priceAedFils Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([eventId, sizeKey])
}

model FloorPlanFeature {
  id       String @id @default(cuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // ENTRANCE_MAIN | ENTRANCE_SIDE | TOILET_FEMALE | TOILET_MALE | OFFICE | LOADING | STAIRS | OTHER
  type     String
  label    String
  // Position/size as a percentage (0-100) of the floor plan canvas/image.
  // See components/floorplan.
  gridX    Float
  gridY    Float
  gridW    Float
  gridH    Float
  rotation Int    @default(0) // degrees, for arrow/door orientation

  createdAt DateTime @default(now())
}

model Booth {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  code String // unique WITHIN the event, e.g. "A5", "B29"
  size String @default("custom") // references PricingTier.sizeKey when set; "custom" when price/color are set directly per booth

  // Per-booth overrides — set directly when adding a booth (name/price/color
  // flow). When priceAedFils is null, price falls back to the event-level
  // then global PricingTier lookup by `size`. When colorHex is null, the
  // floor plan renders the size-tier palette color instead.
  priceAedFils Int?
  colorHex     String?

  // Position/size as a percentage (0-100) of the floor plan canvas/image —
  // lets the admin click-to-place a booth instead of typing coordinates.
  gridX    Float
  gridY    Float
  gridW    Float
  gridH    Float
  rotation Int   @default(0) // degrees, set by dragging the rotate handle in the floor plan builder

  status String @default("AVAILABLE") // AVAILABLE | HELD | RESERVED | SOLD

  // System-driven hold (5 min review / 5 min payment) — enforced server-side
  // by checking holdExpiresAt on every read/write, never trusting the client.
  holdStage           String? // REVIEW | PAYMENT
  holdExpiresAt       DateTime?
  heldByApplicationId String?
  heldByApplication   Application? @relation("BoothHeldBy", fields: [heldByApplicationId], references: [id])

  // Admin-driven manual reservation/sale — no timer.
  assignedApplicationId String?
  assignedApplication   Application? @relation("BoothAssignedTo", fields: [assignedApplicationId], references: [id])
  manualAssigneeName    String? // for walk-ins/favors with no application on file

  priceAedFilsAtSale Int? // snapshot of price actually charged/reserved at, historical
  soldAt             DateTime?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, code])
}

// A Vendor is a DAH business account — created once at signup, independent
// of any event. `verified` gates the vendor dashboard: an unverified vendor
// can log in but sees nothing until DAH manually verifies their business
// (Admin → Vendors). Once verified, they can apply to individual published
// events from their dashboard (see Application below).
model Vendor {
  id           String  @id @default(cuid())
  email        String  @unique
  // The vendor's chosen sign-in name, in the exact casing they typed —
  // shown back to them everywhere. `usernameLower` is the real uniqueness
  // and lookup key (trimmed + lowercased): "SaeedStore", "saeedstore" and
  // " SaeedStore " are all the same account, enforced by the unique index
  // below, not just app-level checks, so a race between two signups can
  // never both succeed.
  username      String
  usernameLower String  @unique
  passwordHash  String
  businessName String
  contactName  String
  phone        String
  category     String // one of lib/constants.ts VENDOR_CATEGORIES, or free text under "Other"
  description  String  @default("") // short business description, shown to admin during verification
  instagram    String?
  verified     Boolean @default(false)

  // Business profile — vendor-editable via /vendor/profile. All optional:
  // trade license fields stay optional even when Settings.tradeLicenseRequired
  // is on (that setting gates applying to events, not account creation).
  logoUrl             String?
  website             String?
  tradeLicenseNumber  String?
  tradeLicenseFileUrl String? // uploaded via the existing Vercel Blob setup, same as floor plan images
  tradeLicenseExpiry  DateTime?

  // `emailVerifiedAt` is a REAL verification flag — set only when the vendor
  // actually clicks and successfully confirms the link sent to their email
  // (see EmailVerificationToken below), never automatically at signup. It is
  // never checked as a gate anywhere (see lib/verification.ts): email is a
  // normal account-communication channel (login, password reset, receipts),
  // shown on Profile/Admin for informational purposes only.
  //
  // Phone verification is the one real eligibility gate — see
  // lib/verification.ts requirePhoneVerifiedVendor(). `phoneVerifiedNumber`
  // is the exact E.164 number that was actually verified: if it no longer
  // matches the current normalized `phone`, the phone is treated as
  // unverified again automatically (see PHONE CHANGE requirement) without
  // needing every phone-editing code path to remember to clear a flag.
  // `phoneVerifiedMethod` records how the CURRENT verification happened
  // ("SMS" via Twilio Verify, or "ADMIN" via manual admin override) — full
  // history of every verification event (including ones since superseded by
  // a phone change) lives in VendorPhoneVerificationLog below.
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  phoneVerifiedNumber String?
  phoneVerifiedMethod String?

  applications            Application[]
  notes                   VendorNote[]
  warnings                VendorWarning[]
  emailVerificationTokens EmailVerificationToken[]
  phoneVerificationLogs   VendorPhoneVerificationLog[]
  emailDeliveries         EmailDelivery[]
  // Every Agreement (VENDOR_TERMS at signup, EVENT_TERMS per booking) this
  // vendor has accepted — look up the VENDOR_TERMS one via
  // `agreementAcceptances.find(a => a.agreement.type === "VENDOR_TERMS")`
  // rather than a direct pointer, since the acceptance row can only be
  // created after this Vendor row exists.
  agreementAcceptances AgreementAcceptance[]
  passwordResetTokens  PasswordResetToken[]
  emailChangeTokens    EmailChangeToken[]
  sessions             VendorSession[]

  // Soft-delete: closing an account never deletes the row (agreements,
  // payments and bookings all reference vendorId and must stay readable),
  // it just disables login and clears non-required personal data. Keeping
  // the row also keeps `usernameLower`/`email` reserved in their unique
  // indexes, so a closed account's identifiers can never be immediately
  // claimed by someone else.
  accountStatus String    @default("ACTIVE") // ACTIVE | CLOSED
  closedAt      DateTime?
  emailChangedAt DateTime? // last time the login email was changed, for audit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per issued vendor login session — makes the session cookie
// actually revocable, unlike a bare stateless JWT. The JWT carries this
// row's id (`sid`); every request re-checks the row here, so logout (this
// row only) and a password reset (every row for this vendor) both take
// effect immediately, not just whenever the token happens to expire on its
// own. `revokedAt` rather than deleting the row keeps a short audit trail.
model VendorSession {
  id        String    @id @default(cuid())
  vendorId  String
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([vendorId])
}

// Same revocable-session pattern for Admin. Admin has no per-user DB row
// (a single shared password, see .env ADMIN_PASSWORD) so there's no vendorId
// equivalent to scope by — logging out revokes just this session's row,
// keeping other concurrently-open admin sessions valid.
model AdminSession {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
}

// Single-use, expiring "forgot password" token. Only a hash is stored —
// the raw token exists solely in the emailed link — so a leaked database
// snapshot can never be used to reset a vendor's password. Every request
// (even for an unknown email) responds identically; this table only fills
// in when the email genuinely matches an account.
model PasswordResetToken {
  id        String    @id @default(cuid())
  vendorId  String
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([vendorId])
}

// Verifies a NEW email address before it becomes the account's real login
// email — the login identifier only changes once this token is consumed,
// so a mistyped or unreachable new address can never lock a vendor out.
model EmailChangeToken {
  id        String    @id @default(cuid())
  vendorId  String
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([vendorId])
}

// Internal delivery log for every transactional email DAH sends — lets
// Admin see sent/delivered/failed status and retry a genuinely failed send,
// without ever storing the email body, tokens, or credentials here.
// `dedupeKey`, when set, is a stable key for the underlying business event
// (e.g. "application_accepted:<applicationId>:<acceptedAt>") — writing a
// second row with the same key hits the unique constraint and is treated as
// "already sent", so a retried request can never fire the same
// notification twice. Rows without a natural one-shot business event (e.g.
// a resendable verification email) simply leave this null.
model EmailDelivery {
  id                String    @id @default(cuid())
  type              String // e.g. EMAIL_VERIFY, PASSWORD_RESET, APPLICATION_ACCEPTED, PAYMENT_RECEIPT, WARNING, ...
  vendorId          String?
  vendor            Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  eventId           String? // Event.id, unrelated (log-only, no FK) so a later event deletion never touches this history
  toEmail           String
  provider          String    @default("resend")
  providerMessageId String?
  status            String    @default("QUEUED") // QUEUED | SENT | DELIVERED | BOUNCED | FAILED
  failReason        String?
  dedupeKey         String?   @unique
  queuedAt          DateTime  @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?

  @@index([vendorId])
  @@index([type])
  @@index([providerMessageId])
}

// Single-use, expiring token proving the vendor controls the email address
// currently on file — used at signup (and any time the current address
// needs re-confirming). Distinct from EmailChangeToken, which verifies a
// NEW address before the login email switches to it. Only a hash is
// stored, same pattern as PasswordResetToken/EmailChangeToken.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  vendorId  String
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([vendorId])
}

// Append-only history of every phone-verification event for a vendor — an
// audit trail distinct from Vendor.phoneVerifiedAt/phoneVerifiedNumber/
// phoneVerifiedMethod (the CURRENT state only). Written on both a real
// Twilio Verify success (method "SMS") and an admin manual override
// (method "ADMIN") — Admin has no per-admin-user identity in this system
// (a single shared password, see AdminSession), so "who" can only ever be
// recorded generically as "ADMIN", not a named person.
model VendorPhoneVerificationLog {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  phone    String // the E.164 number verified at this moment
  method   String // SMS | ADMIN

  createdAt DateTime @default(now())

  @@index([vendorId])
}

// Private DAH-internal notes about a vendor — never returned by any
// vendor-facing API. Timestamped history rather than one editable text
// field, so nothing is ever silently overwritten.
model VendorNote {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  note     String

  createdAt DateTime @default(now())

  @@index([vendorId])
}

// An official notice/warning DAH issues to a vendor's business — distinct
// from VendorNote (private/internal): the vendor CAN see their own
// warnings (minus adminNote), can acknowledge having seen one, and admin
// can track view/ack/resolution over time. Warnings are a communication
// and history tool only — they never auto-reject or auto-ban a vendor
// unless that logic is explicitly added later.
model VendorWarning {
  id       String  @id @default(cuid())
  vendorId String
  vendor   Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  eventId  String?
  event    Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  title       String
  description String
  severity    String @default("NOTICE") // NOTICE | WARNING | FINAL_WARNING
  status      String @default("ACTIVE") // ACTIVE | RESOLVED | WITHDRAWN

  adminNote String? // private — never returned by vendor-facing APIs

  viewedAt       DateTime?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([eventId])
}

// A verified vendor's one-click application to a specific event, applied
// from their dashboard (no form — business info is already on file).
model Application {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Snapshot of the vendor's profile at the time they applied (vendor
  // profile may change later; keep what was true for this application).
  businessName String
  contactName  String
  phone        String
  email        String
  category     String
  instagram    String?

  status String @default("PENDING") // PENDING | REJECTED | ACCEPTED | ACCEPTANCE_EXPIRED

  acceptedAt          DateTime?
  acceptanceExpiresAt DateTime? // deadline to complete payment; independent of booth holds
  acceptanceHoursUsed Int? // the hours value actually applied, for display/audit
  expiredAt           DateTime?
  rejectedAt          DateTime?

  // Server-authoritative 2-minute booth-selection session: set when the
  // vendor opens the booth selector (or resumed if still valid), consumed
  // (cleared) once a booth is actually confirmed. Purely a UI-focus timer —
  // never extends acceptanceExpiresAt, which remains the absolute deadline.
  boothSelectionExpiresAt DateTime?

  cancellationRequests CancellationRequest[]
  adjustments          Adjustment[]
  payments             Payment[]
  agreementAcceptances AgreementAcceptance[]

  heldBooths     Booth[] @relation("BoothHeldBy")
  assignedBooths Booth[] @relation("BoothAssignedTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, status])
  @@index([vendorId])
}

model Payment {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  eventId       String
  boothId       String
  booth         Booth       @relation(fields: [boothId], references: [id])

  amountAedFils Int
  currency      String @default("AED")
  status        String @default("PENDING") // PENDING | SUCCEEDED | FAILED

  provider    String // e.g. "sandbox", "ziina", "shopify_payments", "adcb"
  providerRef String? // charge/session id from the gateway

  // Assigned exactly once, atomically, the moment a payment actually
  // succeeds (via the ReceiptNumberSeq Postgres sequence — see migration) —
  // never a random client-side value, never reused, stable for the life of
  // the payment. Null for PENDING/FAILED payments, which have no receipt.
  receiptNumber String? @unique

  createdAt DateTime  @default(now())
  paidAt    DateTime?
}

model Adjustment {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  amountAedFils  Int // can be negative for a discount/credit
  reason         String
  createdByAdmin Boolean     @default(true)
  createdAt      DateTime    @default(now())
}

model CancellationRequest {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reason        String
  status        String      @default("PENDING") // PENDING | ACKNOWLEDGED
  createdAt     DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Agreements — two independent, versioned document types, deliberately
// never mixed:
//   VENDOR_TERMS: one lineage per account signup (eventId always null).
//   EVENT_TERMS:  one independent lineage PER event (eventId always set) —
//                 duplicating an event copies the current text into a
//                 brand-new lineage, never linked back to the source
//                 event's, so editing one never touches the other.
// Only one row per (type, eventId) may be PUBLISHED at a time; editing a
// published agreement creates a new DRAFT version rather than overwriting
// it in place, so every past acceptance stays pinned to the exact text it
// was made against (see AgreementAcceptance.snapshotBodyHtml below).
// ---------------------------------------------------------------------------
model Agreement {
  id      String  @id @default(cuid())
  type    String // VENDOR_TERMS | EVENT_TERMS
  eventId String? // set only for EVENT_TERMS
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  version  Int
  title    String
  bodyHtml String @db.Text

  status      String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acceptances AgreementAcceptance[]

  @@unique([type, eventId, version])
  @@index([type, eventId, status])
}

// Immutable evidence of one vendor accepting one specific Agreement
// version. Snapshot fields are captured at accept-time and never change
// even if the Agreement row is later edited/republished as a new version
// — the signed record must always be readable exactly as it was accepted,
// independent of the live Agreement row.
model AgreementAcceptance {
  id          String    @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id])
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Set only for EVENT_TERMS acceptances — ties this acceptance to the
  // specific application/booking it was made for.
  applicationId      String?
  application        Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  representativeName String? // typed full name — EVENT_TERMS only

  snapshotType         String
  snapshotTitle        String
  snapshotVersion      Int
  snapshotBodyHtml     String  @db.Text
  snapshotBusinessName String
  snapshotContactName  String
  snapshotEventName    String? // EVENT_TERMS only

  ipAddress String?
  userAgent String?

  acceptedAt DateTime @default(now())

  @@index([vendorId])
  @@index([agreementId])
  @@index([applicationId])
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
