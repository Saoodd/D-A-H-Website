    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.3",
    "dxf-parser": "^1.1.2",
    "exceljs": "^4.4.0",
    "isomorphic-dompurify": "^4.3.0",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.14",
    "next": "16.3.6",
    "obscenity": "^0.4.6",
