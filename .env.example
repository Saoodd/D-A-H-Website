# Copy this file to .env and fill in real values before deploying.
# Never commit .env with real secrets.

# --- Database -----------------------------------------------------------
# A Postgres connection string (Vercel Postgres/Neon, Supabase, or any
# Postgres instance both locally and in production — SQLite's single file
# does not handle concurrent serverless writes safely). Vercel Postgres
# auto-injects this when you attach a database to the project.
DATABASE_URL="postgresql://user:password@localhost:5432/dah_dev"

# --- Auth -----------------------------------------------------------------
# Admin panel password (single admin login — see README "Admin panel").
# Use a long, random value in production.
ADMIN_PASSWORD="changeme-admin-password"

# Secret used to sign admin/vendor session cookies (JWT). Generate a random
# 32+ character string, e.g. `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-long-random-string"

# --- Email (Resend) ---------------------------------------------------------
# https://resend.com — used for every transactional email (application
# received, approved, payment receipt, etc). Leave RESEND_API_KEY empty to
# run in dev-fallback mode, which just logs emails to the console instead of
# sending them — handy for local development without a real key.
RESEND_API_KEY=""
EMAIL_FROM="Dar Al Hay <onboarding@resend.dev>"
# Where DAH gets internal notifications (new application, payment, etc).
ADMIN_NOTIFY_EMAIL="admin@example.com"

# --- Payments (sandbox) -----------------------------------------------------
# Currently always "sandbox" — see payments/gateway.ts. When DAH has chosen
# and completed KYC with Ziina / Shopify Payments / ADCB, implement that
# provider in payments/gateway.ts and switch this value.
PAYMENT_PROVIDER="sandbox"

# --- File uploads (Vercel Blob) --------------------------------------------
# Used for the floor plan image upload in Admin → Events → Floor plan. In
# Vercel: Project → Storage → Create Database → Blob, then connect it to this
# project — it auto-injects BLOB_READ_WRITE_TOKEN. For local dev, copy the
# token from Vercel (Storage → your Blob store → .env.local tab) if you want
# uploads to work locally too; without it, upload will fail locally but the
# rest of the app works fine.
BLOB_READ_WRITE_TOKEN=""

# --- Site -------------------------------------------------------------------
# Public base URL, used in emails and metadata/OG tags. Set this to your real
# domain in production (e.g. https://daralhay.ae).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
