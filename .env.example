# Copy this file to .env and fill in real values before deploying.
# Never commit .env with real secrets.

# --- Database -----------------------------------------------------------
# A Postgres connection string (Vercel Postgres/Neon, Supabase, or any
# Postgres instance both locally and in production — SQLite's single file
# does not handle concurrent serverless writes safely). Vercel Postgres
# auto-injects POSTGRES_* vars when you attach a database to the project —
# set DATABASE_URL to the pooled one (POSTGRES_PRISMA_URL) and DIRECT_URL
# to the non-pooled one (POSTGRES_URL_NON_POOLING).
# Used by the running app, through Prisma 7's node-postgres driver adapter
# (lib/prisma.ts). Prisma-engine-only URL params such as `pgbouncer=true` or
# `connection_limit` are harmless but ignored by that driver.
DATABASE_URL="postgresql://user:password@localhost:5432/dah_dev"

# Direct (non-pooled) connection, used by the Prisma CLI — `migrate deploy`
# at build time, plus `migrate dev`, `db seed`, `studio` — via
# prisma.config.ts. Required for migrations: there is no fallback to
# DATABASE_URL. Locally this can be the same value as DATABASE_URL; in
# production it must be the provider's direct connection string, because
# running migrations through a PgBouncer-style pooler causes Prisma's
# advisory-lock wait to time out (error P1002) even though the pooled
# connection itself works fine.
DIRECT_URL="postgresql://user:password@localhost:5432/dah_dev"

# --- Auth -----------------------------------------------------------------
# Admin panel password (single admin login — see README "Admin panel").
# Use a long, random value in production.
ADMIN_PASSWORD="changeme-admin-password"

# Secret used to sign admin/vendor session cookies (JWT). Generate a random
# 32+ character string, e.g. `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-long-random-string"

# --- Email (Resend) ---------------------------------------------------------
# https://resend.com — used for every transactional email (verification,
# password reset, application received/approved, payment receipt, etc).
# Leave RESEND_API_KEY empty to run in dev-fallback mode, which just logs
# emails to the console instead of sending them — handy for local
# development without a real key.
RESEND_API_KEY=""
# The verified sending domain in Resend (domain part only, no mailbox) —
# emails send from "Dar Al Hay Events <no-reply@<this domain>>". There is
# intentionally no real mailbox behind that address; it's a system sender.
RESEND_EMAIL_DOMAIN="dahevents.com"
# Legacy fallback sender, used only when RESEND_EMAIL_DOMAIN is unset (e.g.
# local dev without a verified custom domain, using Resend's own
# onboarding@resend.dev sender instead).
EMAIL_FROM="Dar Al Hay <onboarding@resend.dev>"
# Where DAH gets internal notifications (new application, payment, etc).
ADMIN_NOTIFY_EMAIL="admin@example.com"
# Signing secret for Resend delivery-status webhooks (Settings → Webhooks
# in Resend), used to verify /api/webhooks/resend requests are genuinely
# from Resend. Optional — without it the webhook endpoint stays inert.
RESEND_WEBHOOK_SECRET=""

# --- WhatsApp (Infobip WhatsApp Business API) --------------------------------
# The SOLE Infobip integration DAH uses. Auth uses an API Key in the
# "App <key>" scheme, sent server-side only, never exposed to the
# browser — that key must actually have WhatsApp send permission on
# Infobip's side; a key that only has SMS/2FA scope will fail with an
# authorization error at send time (logged server-side, status + a
# redacted response body only — never the key itself).
#
# Base connection (required together) — leave unset to run with
# WhatsApp disabled entirely; the app fails safely with a clear "not
# configured" message rather than exposing an error, both for phone
# verification (see lib/whatsapp/otp.ts) and for the Admin
# Communications Center (Admin → Communications), which sends APPROVED
# TEMPLATE messages only — never free-form/marketing text outside an
# open customer-service window, per Meta's WhatsApp Business rules.
INFOBIP_WHATSAPP_BASE_URL=""
INFOBIP_WHATSAPP_API_KEY=""
INFOBIP_WHATSAPP_SENDER=""
# The exact, single approved WhatsApp AUTHENTICATION-category template
# phone verification uses — DELIBERATELY explicit, not "whichever
# Authentication template happens to exist first" (there may eventually
# be more than one on the account). The app verifies live against
# Infobip that this template exists and is approved before ever using
# it (see lib/whatsapp/otp.ts getConfiguredAuthTemplate()); a typo'd or
# rejected template name fails phone verification loudly rather than
# silently substituting a different template. The broadcast
# Communications Center's own template picker is unaffected by this —
# it still lists every template live, unrelated to this pair.
INFOBIP_WHATSAPP_AUTH_TEMPLATE=""
INFOBIP_WHATSAPP_AUTH_TEMPLATE_LANGUAGE=""

# Secures POST /api/webhooks/infobip-whatsapp (delivery-report callback).
# Infobip has no documented request-signing scheme we could confirm without
# their docs, so this is DAH's own shared secret instead — generate with
# e.g. `openssl rand -base64 32`, set it here AND in Vercel's project env
# vars, then configure Infobip's WhatsApp DLR callback URL as
# `<site>/api/webhooks/infobip-whatsapp?secret=<this value>` in the Infobip
# portal. Leave unset to disable the route entirely (it refuses every
# request rather than trusting an unauthenticated payload).
INFOBIP_WEBHOOK_SECRET=""

# --- Scheduled reminders (Vercel Cron) ---------------------------------------
# Secures GET /api/cron/notifications (see vercel.json's `crons` entry —
# hourly), which sends every reminder-shaped WhatsApp notification
# (acceptance/booth-selection/payment/event/vendor-setup reminders). Vercel
# automatically sends this exact value as an `Authorization: Bearer <value>`
# header when calling a cron route — set the SAME value here and in Vercel's
# project env vars. Generate with e.g. `openssl rand -base64 32`. Leave unset
# to disable the route entirely (it refuses every request, cron or not).
CRON_SECRET=""

# --- Sign in with Google (optional) ----------------------------------------
# Lets vendors link a Google account from My Profile and then use
# "Continue with Google" on the login page. Leave both unset to keep the
# feature off (no button, routes answer 404). Linking only happens from a
# signed-in profile: an unlinked Google account never creates or matches a
# DAH account, not even by email.
# Setup: Google Cloud Console > APIs & Services > Credentials > Create
# OAuth client ID > "Web application". Authorised redirect URI:
#   <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
# e.g. https://your-domain/api/auth/google/callback (add
# http://localhost:3000/api/auth/google/callback for local testing).
# The consent screen only needs the "openid" and "email" scopes.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Payments ---------------------------------------------------------------
# "sandbox" (default) until a real provider is integrated — see
# docs/PAYMENTS.md for the integration checklist. Never invent a value here:
# an unknown name falls back to the sandbox (which production disables).
# "local-test" is a development-only stand-in for testing the webhook /
# reconciliation / refund paths; production builds refuse it.
PAYMENT_PROVIDER="sandbox"
# Only for PAYMENT_PROVIDER="local-test" (development): webhook signing secret.
# LOCAL_TEST_PAYMENTS_SECRET="any-local-value"

# The sandbox gateway takes the browser's word that a payment succeeded, so
# production refuses online checkout while it's the configured provider:
# vendors see "DAH will contact you to arrange payment" and admins confirm
# bookings with "Record offline payment" on the application page (see
# lib/paymentMode.ts). Set to "true" ONLY on a deployment where fake payments
# are acceptable, e.g. a Vercel Preview with its own test database. Never
# set it on Production. Has no effect outside production builds (local dev
# always allows the sandbox).
# ALLOW_SANDBOX_PAYMENTS="true"

# --- File uploads (Vercel Blob — TWO stores) --------------------------------
# This project connects TWO separate Vercel Blob stores. Every upload route
# picks one explicitly (see lib/blob.ts) — nothing ever relies on "whichever
# store happens to be ambient".
#
# PRIVATE store (the original/default store — unprefixed vars below): trade
# licence documents, receipts, any other admin-only file. Read back only
# through an authenticated proxy route (see lib/privateDocs.ts), never a raw
# Blob URL.
# PUBLIC store (connected with the "PUBLIC_BLOB" env var prefix): gallery
# photos, event cover images, floor plan images, vendor logos — anything
# intentionally shown on the public site.
#
# Two ways credentials reach the app for EACH store — @vercel/blob resolves
# the private/default pair itself; the public store's vars are read
# explicitly by lib/blob.ts:
#
# 1. OIDC (recommended, no static secret at all): on each store's Projects
#    tab, use "Upgrade to OIDC". Vercel then auto-injects a short-lived,
#    auto-rotated VERCEL_OIDC_TOKEN (shared) plus a per-store STORE_ID into
#    every deployment — do not set any of these here; they only exist
#    inside Vercel's own runtime, never in a local .env.
# 2. A long-lived *_READ_WRITE_TOKEN (fallback, or for local dev): from
#    Storage → that store → .env.local tab. Used automatically whenever the
#    OIDC pair for that store isn't present — e.g. running locally.
#    Without either pair for a given store, uploads to it fail with a clear
#    "not configured" error; the rest of the app still works fine.
#
# Private (default) store:
BLOB_READ_WRITE_TOKEN=""
# Public store — set ONE of these two (not both are required; the token
# takes priority if both are present):
PUBLIC_BLOB_READ_WRITE_TOKEN=""
PUBLIC_BLOB_STORE_ID=""

# --- Agreements: optional spreadsheet mirror ---------------------------------
# Every signed agreement is fully recorded in the database (Admin →
# Agreements → All Signed Agreements, with CSV export) — the database is
# always the source of truth. If set, each new acceptance is ALSO
# best-effort POSTed as JSON to this URL (e.g. a Google Sheets Apps Script
# webhook) — a failed or slow request never blocks or fails the acceptance
# itself. Leave unset to skip this entirely.
AGREEMENTS_SHEETS_WEBHOOK_URL=""

# --- Site -------------------------------------------------------------------
# Public base URL, used in emails and metadata/OG tags. Set this to your real
# domain in production (e.g. https://daralhay.ae).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
