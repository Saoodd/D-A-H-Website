# Copy this file to .env and fill in real values before deploying.
# Never commit .env with real secrets.

# --- Database -----------------------------------------------------------
# A Postgres connection string (Vercel Postgres/Neon, Supabase, or any
# Postgres instance both locally and in production — SQLite's single file
# does not handle concurrent serverless writes safely). Vercel Postgres
# auto-injects POSTGRES_* vars when you attach a database to the project —
# set DATABASE_URL to the pooled one (POSTGRES_PRISMA_URL) and DIRECT_URL
# to the non-pooled one (POSTGRES_URL_NON_POOLING).
DATABASE_URL="postgresql://user:password@localhost:5432/dah_dev"

# Direct (non-pooled) connection, used only for running migrations at
# build time. Required — Prisma does not fall back to DATABASE_URL if this
# is unset. Locally this can be the same value as DATABASE_URL; in
# production it must be the provider's direct connection string, because
# running migrations through a PgBouncer-style pooler causes Prisma's
# advisory-lock wait to time out (error P1002) even though the pooled
# connection itself works fine.
DIRECT_URL="postgresql://user:password@localhost:5432/dah_dev"

# --- Auth -----------------------------------------------------------------
# Admin panel password (single admin login — see README "Admin panel").
# Use a long, random value in production.
ADMIN_PASSWORD="changeme-admin-password"

# Secret used to sign admin/vendor session cookies (JWT). Generate a random
# 32+ character string, e.g. `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-long-random-string"

# --- Email (Resend) ---------------------------------------------------------
# https://resend.com — used for every transactional email (application
# received, approved, payment receipt, etc). Leave RESEND_API_KEY empty to
# run in dev-fallback mode, which just logs emails to the console instead of
# sending them — handy for local development without a real key.
RESEND_API_KEY=""
EMAIL_FROM="Dar Al Hay <onboarding@resend.dev>"
# Where DAH gets internal notifications (new application, payment, etc).
ADMIN_NOTIFY_EMAIL="admin@example.com"

# --- Payments (sandbox) -----------------------------------------------------
# Currently always "sandbox" — see payments/gateway.ts. When DAH has chosen
# and completed KYC with Ziina / Shopify Payments / ADCB, implement that
# provider in payments/gateway.ts and switch this value.
PAYMENT_PROVIDER="sandbox"

# --- File uploads (Vercel Blob) --------------------------------------------
# Used for every file/image upload in the app: gallery photos, event cover
# images, vendor logos, trade licence documents, and floor plan images. In
# Vercel: Project → Storage → connect your Blob store to this project.
#
# Two ways credentials reach the app — @vercel/blob resolves them itself,
# nothing to change in code either way:
#
# 1. OIDC (recommended, no static secret at all): on the store's Projects
#    tab, use "Upgrade to OIDC". Vercel then auto-injects a short-lived,
#    auto-rotated VERCEL_OIDC_TOKEN plus BLOB_STORE_ID into every deployment
#    — do not set either of these here; they only exist inside Vercel's own
#    runtime, never in a local .env.
# 2. BLOB_READ_WRITE_TOKEN (fallback, or for local dev): a long-lived token
#    from Storage → your Blob store → .env.local tab. Used automatically
#    whenever the OIDC pair above isn't present — e.g. running locally.
#    Without either, uploads fail with a clear "not configured" error; the
#    rest of the app still works fine.
BLOB_READ_WRITE_TOKEN=""

# --- Agreements: optional spreadsheet mirror ---------------------------------
# Every signed agreement is fully recorded in the database (Admin →
# Agreements → All Signed Agreements, with CSV export) — the database is
# always the source of truth. If set, each new acceptance is ALSO
# best-effort POSTed as JSON to this URL (e.g. a Google Sheets Apps Script
# webhook) — a failed or slow request never blocks or fails the acceptance
# itself. Leave unset to skip this entirely.
AGREEMENTS_SHEETS_WEBHOOK_URL=""

# --- Site -------------------------------------------------------------------
# Public base URL, used in emails and metadata/OG tags. Set this to your real
# domain in production (e.g. https://daralhay.ae).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
